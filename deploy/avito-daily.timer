[Unit]
Description=Avito daily pipeline once nightly (Yekaterinburg 03:00)

[Timer]
# Один прогон после закрытия клиентского пика (не раньше ~02:00).
# Днём/вечером не трогаем: склад ночью не меняется, админка booking свободна.
OnCalendar=*-*-* 03:00:00
Persistent=true
Unit=avito-daily.service

[Install]
WantedBy=timers.target
